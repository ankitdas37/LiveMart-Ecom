# ==============================================================
# LiveMart Backend - Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ==============================================================

# --- Runtime Environment ---
# Set to 'production' on live server — enables HSTS, DB TLS, hides stack traces
NODE_ENV=development

# --- Server ---
PORT=5000

# --- Database (MySQL / Sequelize) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ecommerce_db

# --- Cloudinary (Image & File Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Email (Gmail SMTP + App Password) ---
# Generate an app password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- JWT ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_strong_random_secret_here

# --- Google OAuth ---
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Developer Contact Email ---
# Email that receives messages sent via the "Contact Developer" form on About page
DEVELOPER_EMAIL=your_developer_email@gmail.com

# --- App URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- Optional: Google Sheets Webhook ---
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

# --- Admin Setup Script (setupAdmin.js only) ---
# Only needed when running: node setupAdmin.js
# Use a strong, unique password — change it after first login
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_NAME=LiveMart Admin
# DEMOTE_EMAIL=email_to_demote_to_user@gmail.com
